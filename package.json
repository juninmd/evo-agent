{
  "name": "evo-agent",
  "version": "1.0.0",
  "description": "Self-improving AI developer agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "health": "tsx src/observability/health-cli.ts",
    "benchmark:editorial": "tsx src/agent/benchmark-cli.ts",
    "prompt:rollback": "tsx src/agent/prompt-rollback-cli.ts",
    "edition": "tsx src/agent/edition-cli.ts",
    "backfill:articles": "node dist/agent/backfill-cli.js",
    "smoke:reddit-comments": "tsx src/crawler/reddit-smoke.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/publisher/assets','dist/publisher/assets',{recursive:true})\"",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@juninmd/digest-kit": "^0.2.3",
    "@octokit/rest": "^22.0.1",
    "ai": "^7.0.162",
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "node-cron": "^4.2.1",
    "playwright": "^1.64.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
